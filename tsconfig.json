{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "react", "react-dom"]
  },
  "include": ["demo/remotion/src/**/*.ts", "demo/remotion/src/**/*.tsx", "remotion.config.ts"]
}
