{
  "name": "clavis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-minimized, rule-bound payroll automation on NEAR testnet",
  "workspaces": [
    "agent",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=@clavis/agent && npm run build --workspace=@clavis/frontend && tsc -p tsconfig.api.json --pretty false",
    "typecheck": "npm run typecheck --workspace=@clavis/agent && npm run typecheck --workspace=@clavis/frontend && tsc -p tsconfig.api.json --pretty false",
    "test": "npm run test:api && npm run test:agent && npm run test:contract",
    "test:api": "node --import tsx --test tests/api/*.test.ts",
    "test:e2e": "npm run build --workspace=@clavis/frontend && npm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "test:agent": "npm run test --workspace=@clavis/agent",
    "test:contract": "cargo test --manifest-path contract/Cargo.toml",
    "build:contract": "cargo build --manifest-path contract/Cargo.toml --target wasm32-unknown-unknown --release",
    "demo:narration": "node --experimental-strip-types scripts/generate-demo-narration.ts",
    "demo:record": "node --experimental-strip-types scripts/record-demo.ts",
    "demo:record:smoke": "node --experimental-strip-types scripts/record-demo.ts --smoke",
    "demo:record:browser-smoke": "node --experimental-strip-types scripts/record-demo.ts --browser-smoke",
    "demo:register-recording": "node --experimental-strip-types scripts/register-demo-recording.ts",
    "demo:studio": "remotion studio demo/remotion/src/index.ts",
    "demo:render": "remotion render demo/remotion/src/index.ts ClavisDemo demo/output/clavis-demo-1080p.mp4 --codec=h264 --crf=16 --audio-codec=aac --pixel-format=yuv420p",
    "demo:typecheck": "tsc -p demo/tsconfig.json --noEmit",
    "dev:agent": "npm run dev --workspace=@clavis/agent",
    "dev:frontend": "npm run dev --workspace=@clavis/frontend"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "nanoid@5.1.5": "5.1.16",
    "decode-uri-component@0.2.2": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@remotion/cli": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "obs-websocket-js": "5.0.8",
    "playwright": "1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
