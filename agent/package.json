{
  "name": "@clavis/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rule-bound autonomous payroll agent for Clavis",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "simulate-attack": "tsx src/simulate-attack.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastnear/intents": "^2.5.0",
    "borsh": "^1.0.0",
    "dotenv": "^16.4.7",
    "near-api-js": "6.5.1",
    "resend": "^6.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
