# Shared testnet agent identity. A Full Access key is only accepted when the
# explicit testnet-only override below is enabled.
NEAR_ACCOUNT_ID=clavis-agent.testnet
NEAR_PRIVATE_KEY=ed25519:REPLACE_WITH_AGENT_KEY
ALLOW_FULL_ACCESS_AGENT=false

# NEAR network and factory
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
FACTORY_CONTRACT_ID=factory.clavis.testnet

# Live NEAR Intents relay and settlement fallback
INTENTS_CONTRACT_ID=intents.near
SOLVER_RELAY_URL=https://solver-relay-v2.chaindefuser.com/rpc
INTENTS_API_KEY=
SETTLEMENT_ACCOUNT_ID=
SETTLEMENT_PRIVATE_KEY=

# Multi-business agent runtime
PAYROLL_CONFIG_PATH=./config/payroll.local.json
PAYROLL_DIRECTORY=./config/payrolls
AGENT_DATA_DIRECTORY=./data/contracts
INTENT_STATE_PATH=./data/intents.json
REPORT_DIRECTORY=./reports
POLL_INTERVAL_MS=60000
RETRY_DELAY_MS=5000
INTENT_RETRY_DELAY_MS=30000
RUN_ONCE=false

# Notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=Clavis Testnet <onboarding@resend.dev>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.fastnear.com
VITE_FACTORY_CONTRACT_ID=factory.clavis.testnet
VITE_ROOT_CONTRACT_ID=clavis.testnet
VITE_EXPLORER_URL=https://testnet.nearblocks.io
VITE_NEARBLOCKS_API_URL=https://api-testnet.nearblocks.io

# Reproducible demo recipients used by scripts/setup.sh
OWNER_ID=clavis.testnet
CONTRACT_ID=clavis.testnet
WORKER_ONE_ID=worker-one.testnet
WORKER_TWO_ID=worker-two.testnet
WORKER_THREE_ID=worker-three.testnet
