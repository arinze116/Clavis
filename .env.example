# Preferred multi-contract configuration: one Function Call private key per
# payroll contract, each restricted to request_payment on that receiver.
AGENT_CREDENTIALS_PATH=./config/agent-credentials.local.json
# Legacy single-contract mode only. Omit these when AGENT_CREDENTIALS_PATH is set.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
LEGACY_AGENT_CONTRACT_ID=

# NEAR network and factory
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
FACTORY_CONTRACT_ID=factory.clavis.testnet

# Relay status endpoint retained for legacy intent evidence. New payroll
# execution fails closed for cross-chain routes until custody can remain
# contract-controlled end to end.
SOLVER_RELAY_URL=https://solver-relay-v2.chaindefuser.com/rpc
INTENTS_API_KEY=

# Multi-business agent runtime
PAYROLL_CONFIG_PATH=./config/payroll.local.json
PAYROLL_DIRECTORY=./config/payrolls
AGENT_DATA_DIRECTORY=./data/contracts
INTENT_STATE_PATH=./data/intents.json
REPORT_DIRECTORY=./reports
POLL_INTERVAL_MS=60000
NOTIFICATION_EVENT_POLL_INTERVAL_MS=10000
RETRY_DELAY_MS=5000
INTENT_RETRY_DELAY_MS=30000
RUN_ONCE=false

# Notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=Clavis Testnet <onboarding@resend.dev>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=

# Signed notification-link API served by the VPS agent. Keep the API key on
# the agent and in Vercel server-side environment variables only.
NOTIFICATION_API_ENABLED=false
NOTIFICATION_API_KEY=
NOTIFICATION_API_HOST=127.0.0.1
NOTIFICATION_API_PORT=8787
NOTIFICATION_PREFERENCES_PATH=./data/notification-preferences.json
NOTIFICATION_SESSION_TTL_MS=2592000000
NOTIFICATION_ALLOWED_ORIGINS=https://clavisapp.vercel.app,http://localhost:5173

# Vercel server-side proxy variables (do not prefix these with VITE_).
CLAVIS_AGENT_API_URL=https://notifications.example.com/v1/notifications
CLAVIS_AGENT_API_KEY=
# Optional private bridge when the cloud firewall cannot expose HTTPS. Use a
# dedicated authorized key restricted to permitopen="127.0.0.1:8787".
CLAVIS_AGENT_SSH_HOST=
CLAVIS_AGENT_SSH_PORT=22
CLAVIS_AGENT_SSH_USER=
CLAVIS_AGENT_SSH_PRIVATE_KEY=
CLAVIS_AGENT_SSH_HOST_KEY_SHA256=

# NEAR AI Cloud (Vercel server-side only). Never use a VITE_ prefix for secrets.
NEAR_AI_API_KEY=
# Optional comma-separated priority list. The proxy checks NEAR AI's live model
# catalog first and automatically selects another instruction model if these move.
NEAR_AI_MODELS=meta-llama/Llama-3.3-70B-Instruct,deepseek-ai/DeepSeek-V4.1-Flash-1017
# Per-model timeout. Failed models fall through within a 52-second total budget.
NEAR_AI_MODEL_TIMEOUT_MS=25000
NEAR_AI_DISCOVER_MODELS=true
# AI proxy abuse controls. Browser requests must be same-origin or listed here.
CLAVIS_AI_ALLOWED_ORIGINS=https://clavisapp.vercel.app,http://localhost:5173
CLAVIS_AI_ALLOW_ORIGINLESS_REQUESTS=false
CLAVIS_AI_RATE_LIMIT_PER_MINUTE=12
# Optional public RPC overrides used only for point-in-time route observations.
CLAVIS_NEAR_TESTNET_RPC_URL=https://test.rpc.fastnear.com
CLAVIS_ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CLAVIS_BNB_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Frontend
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
VITE_FACTORY_CONTRACT_ID=factory.clavis.testnet
VITE_ROOT_CONTRACT_ID=clavis.testnet
VITE_EXPLORER_URL=https://testnet.nearblocks.io
VITE_NEARBLOCKS_API_URL=https://api-testnet.nearblocks.io
VITE_NOTIFICATION_API_URL=/api/notifications

# Reproducible demo recipients used by scripts/setup.sh
OWNER_ID=clavis.testnet
CONTRACT_ID=clavis.testnet
WORKER_ONE_ID=worker-one.testnet
WORKER_TWO_ID=worker-two.testnet
WORKER_THREE_ID=worker-three.testnet
