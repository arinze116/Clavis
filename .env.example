# Deployment owner
OWNER_ID=owner.testnet

# Agent identity. Use a Function Call Key restricted to request_payment.
NEAR_ACCOUNT_ID=clavis-agent.testnet
NEAR_PRIVATE_KEY=ed25519:REPLACE_WITH_RESTRICTED_FUNCTION_CALL_KEY

# Contract
CONTRACT_ID=clavis.testnet

# Network
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com

# NEAR Intents / confidential execution
INTENTS_CONTRACT_ID=intents.near
CONFIDENTIAL_EXECUTOR_URL=
INTENTS_API_KEY=
DRY_RUN_INTENTS=true

# Agent runtime
REPORT_OWNER_ID=owner.testnet
PAYROLL_CONFIG_PATH=./config/payroll.local.json
AGENT_STATE_PATH=./data/state.json
REPORT_DIRECTORY=./reports
POLL_INTERVAL_MS=60000
RETRY_DELAY_MS=5000
RUN_ONCE=false

# Frontend (copy this file to frontend/.env and keep only VITE_* values)
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.fastnear.com
VITE_CONTRACT_ID=clavis.testnet
VITE_EXPLORER_URL=https://testnet.nearblocks.io
VITE_PRIVATE_API_URL=

# Reproducible demo recipients used by scripts/setup.sh
WORKER_ONE_ID=worker-one.testnet
WORKER_TWO_ID=worker-two.testnet
WORKER_THREE_ID=worker-three.testnet
